# Base URL of the FastAPI backend, INCLUDING the /api/v1 prefix.
# This is the variable that matters for static builds (Vercel, Netlify):
# it is baked into the bundle at build time, so after changing it you must
# redeploy. Leave unset to use the Vite dev proxy (/api/v1 -> dev server).
#
#   Vercel / production example:
#   VITE_API_BASE_URL=https://link-easy-production.up.railway.app/api/v1
#
#   Local development example:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# NOTE: a trailing slash is harmless — the client normalizes it away.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Only used by `vite dev`: where the dev server proxies /api to.
# Has NO effect on a Vercel production build.
# VITE_BACKEND_URL=http://localhost:8000
